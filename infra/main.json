{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "switzerlandnorth"
    },
    "acrName": {
    "type": "string",
    "metadata": { "description": "Name of existing ACR registry (without .azurecr.io), e.g. movienotebook" }
    },
    "acrResourceGroup": {
    "type": "string",
    "defaultValue": "[resourceGroup().name]",
    "metadata": { "description": "Resource group where the ACR registry exists (default: current RG)" }
    },
    "acrLoginServer": {
    "type": "string",
    "metadata": { "description": "ACR login server, e.g. movienotebook.azurecr.io" }
    },
    "backendName": { "type": "string" },
    "frontendName": { "type": "string" }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "movie-app-plan",
      "location": "[parameters('location')]",
      "sku": { "name": "B1", "tier": "Basic" },
      "properties": { "reserved": true }
    },

    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "kind": "app,linux,container",
      "name": "[parameters('backendName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
      "[resourceId('Microsoft.Web/serverfarms','movie-app-plan')]"
      ],

      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms','movie-app-plan')]",
        "siteConfig": {
          "linuxFxVersion": "[concat('DOCKER|', parameters('acrLoginServer'), '/movie-backend:latest')]",
          "acrUseManagedIdentityCreds": true,
          "appCommandLine": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
          "appSettings": [
            { "name": "WEBSITES_PORT", "value": "8000" },
            { "name": "DATABASE_URL", "value": "sqlite:////home/data/movies.db" },
            { "name": "CORS_ORIGINS", "value": "[concat('https://', parameters('frontendName'), '.azurewebsites.net')]" },
            { "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE", "value": "true" }
          ]
        }
      }
    },

    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('frontendName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
      "[resourceId('Microsoft.Web/serverfarms','movie-app-plan')]"
      ],

      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms','movie-app-plan')]",
        "siteConfig": {
          "linuxFxVersion": "[concat('DOCKER|', parameters('acrLoginServer'), '/movie-frontend:latest')]",
          "acrUseManagedIdentityCreds": true,
          "appSettings": [
            {
              "name": "WEBSITES_PORT",
              "value": "80"
            },
            {
              "name": "VITE_API_URL",
              "value": "[concat('https://', parameters('backendName'), '.azurewebsites.net')]"
            }
          ]
        }
      }
    },

    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, parameters('acrName'), parameters('backendName'), 'AcrPull')]", 
      "scope": "[resourceId(subscription().subscriptionId, parameters('acrResourceGroup'), 'Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('backendName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions','7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('backendName')), '2023-01-01', 'Full').identity.principalId]"
      }
    },

    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, parameters('acrName'), parameters('frontendName'), 'AcrPull')]",
      "scope": "[resourceId(subscription().subscriptionId, parameters('acrResourceGroup'), 'Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('frontendName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions','7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('frontendName')), '2023-01-01', 'Full').identity.principalId]"
      }
    }
  ]
}
